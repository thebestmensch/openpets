<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jm.openpets-rotate</string>

	<key>ProgramArguments</key>
	<array>
		<string>/Users/jm/bin/openpets-rotate</string>
	</array>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/Users/jm/.bun/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>HOME</key>
		<string>/Users/jm</string>
	</dict>

	<key>StartInterval</key>
	<integer>3600</integer>

	<key>RunAtLoad</key>
	<false/>

	<key>StandardOutPath</key>
	<string>/tmp/openpets-rotate.log</string>

	<key>StandardErrorPath</key>
	<string>/tmp/openpets-rotate.log</string>
</dict>
</plist>
